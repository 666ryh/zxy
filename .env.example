# Copy into server/.env.local (ignored by Git). Never put SMTP credentials in VITE_* variables.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-account@qq.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=your-account@qq.com
AUTH_DEV_MODE=false
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=kejian_app
DB_PASSWORD=replace-with-project-database-password
DB_NAME=kejian
# Optional local path to mysqldump. Linux Docker uses mysqldump on PATH.
MYSQLDUMP_BIN=D:/mysql-8.3.0-winx64/bin/mysqldump.exe
